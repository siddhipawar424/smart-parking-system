# ── Backend Environment Variables ────────────────────────────────────────────
# For LOCAL DEVELOPMENT: application.properties already has working defaults.
# You do NOT need this file to run locally.
#
# For PRODUCTION deployment: set these as real OS environment variables
# (e.g., in your cloud platform, Docker Compose, or CI/CD pipeline).
# Do NOT commit a filled .env file to git.

# Server
SERVER_PORT=8080

# Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/smart_parking_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_production_mysql_password_here

# JWT (minimum 32 characters, use a random string in production)
JWT_SECRET=your-very-long-random-secret-key-minimum-32-chars
JWT_EXPIRATION=86400000
